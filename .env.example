# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect (creator payouts)
# Connect 用の webhook エンドポイントを別途登録した場合の署名シークレット。
# account.updated で連携ステータスを同期する。未設定でも他機能は動作する。
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# プラットフォーム手数料率（0〜1 未満）。projects.platform_fee_rate 未設定時の既定値。
PLATFORM_FEE_RATE=0.10

# Resend (transactional email)
RESEND_API_KEY=re_...
# Verified sender address used for all outgoing mail
RESEND_FROM="FanUp <noreply@fanup.example>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Shared secret guarding the Vercel Cron endpoint
CRON_SECRET=generate-a-long-random-string
